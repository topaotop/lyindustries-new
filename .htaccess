DirectoryIndex index.php

<IfModule mod_rewrite.c>
  RewriteEngine On
  # Old static URLs (index.html, about.html, …) → PHP pages
  RewriteCond %{REQUEST_URI} ^(.*/)(index|about|catalog|contact)\.html$
  RewriteRule \.html$ %1%2.php [R=301,L,QSA]

  # Pages of the previous www.lyindustries.com site → homepage (query string dropped)
  RewriteCond %{REQUEST_URI} ^(.*/)(innovation|shop|products_detail|braiding|crochet|finishing|needle_loom|raschel)\.php$
  RewriteRule \.php$ %1? [R=301,L]
</IfModule>

# Not web pages: PHP partials, content cache, CLI tools, docs/SQL
<IfModule mod_alias.c>
  RedirectMatch 404 ^/(.*/)?(includes|cache|tools|docs)/
  # DB credentials file — never reachable from the web
  RedirectMatch 404 (?i)/connectgrp\.php$
</IfModule>

# Uploaded images (admin) — never run anything from uploads/, only serve images
<IfModule mod_alias.c>
  RedirectMatch 404 (?i)^/(.*/)?uploads/.*\.(php\d?|phtml|phar|pl|py|cgi|asp|aspx|exe|sh|html?|svg)$
</IfModule>
