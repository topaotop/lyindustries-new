DirectoryIndex index.php
# no folder listings (uploads/, assets/ …)
Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On
  # Old static URLs (index.html, about.html, …) → PHP pages
  RewriteCond %{REQUEST_URI} ^(.*/)(index|about|catalog|contact)\.html$
  RewriteRule \.html$ %1%2.php [R=301,L,QSA]

  # robots.txt / sitemap.xml are generated (robots.php, sitemap.php)
  RewriteRule ^robots\.txt$ robots.php [L]
  RewriteRule ^sitemap\.xml$ sitemap.php [L]

  # English site: /en/... → the same pages with lang=en (no copies); files under /en/ come from
  # the site root so relative links (assets, uploads, api) work in both languages
  RewriteCond %{REQUEST_URI} ^(.*/)en$
  RewriteRule ^en$ %1en/ [R=301,L]
  RewriteRule ^en/$ index.php?lang=en [QSA,L]
  RewriteRule ^en/(index|about|catalog|contact)\.php$ $1.php?lang=en [QSA,L]
  RewriteRule ^en/((?:assets|uploads|api)/.+)$ $1 [L]

  # Pages of the previous www.lyindustries.com site → homepage (query string dropped)
  RewriteCond %{REQUEST_URI} ^(.*/)(innovation|shop|products_detail|braiding|crochet|finishing|needle_loom|raschel)\.php$
  RewriteRule \.php$ %1? [R=301,L]
</IfModule>

# Not web pages: PHP partials, content cache, CLI tools, docs/SQL
<IfModule mod_alias.c>
  RedirectMatch 404 ^/(.*/)?(includes|cache|tools|docs)/
  # DB credentials file — never reachable from the web
  RedirectMatch 404 (?i)/connectgrp\.php$
</IfModule>

# Uploaded images (admin) — only images are served from uploads/, nothing else, never a script
<IfModule mod_alias.c>
  RedirectMatch 404 (?i)^/(.*/)?uploads/.*\.(ph|pl|py|cgi|asp|sh|exe|s?html?|xht|svg)
  RedirectMatch 404 (?i)^/(.*/)?uploads/(?!.*\.(webp|jpe?g|png)$)
</IfModule>
