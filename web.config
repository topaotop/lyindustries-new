<?xml version="1.0" encoding="UTF-8"?>
<!--
  IIS config (192.168.0.70) — same role as .htaccess on Apache.
  • ใช้ PHP 8.4 (C:\PHP84) แทน PHP 7.1 ที่เป็นค่า default ของ IIS — โค้ดใช้ syntax ของ PHP 8
  • redirect 301 จาก URL เดิม *.html → *.php
  • ห้ามเปิด includes/ ตรงจากเว็บ
  • IIS 8.5 ไม่รู้จัก .woff2 → ต้องเพิ่ม MIME ไม่งั้นฟอนต์ได้ 404
-->
<configuration>
  <system.webServer>
    <handlers>
      <remove name="PHP_via_FastCGI" />
      <remove name="PHP53_via_FastCGI" />
      <add name="PHP84_lyi" path="*.php" verb="GET,HEAD,POST,DELETE" modules="FastCgiModule" scriptProcessor="C:\PHP84\php-cgi.exe" resourceType="Either" />
    </handlers>

    <defaultDocument>
      <files>
        <clear />
        <add value="index.php" />
      </files>
    </defaultDocument>

    <staticContent>
      <remove fileExtension=".woff2" />
      <mimeMap fileExtension=".woff2" mimeType="font/woff2" />
    </staticContent>

    <security>
      <requestFiltering>
        <hiddenSegments>
          <add segment="includes" />
        </hiddenSegments>
      </requestFiltering>
    </security>

    <rewrite>
      <rules>
        <rule name="Old .html pages to .php" stopProcessing="true">
          <match url="^(index|about|catalog|contact)\.html$" />
          <action type="Redirect" url="{R:1}.php" redirectType="Permanent" appendQueryString="true" />
        </rule>
      </rules>
    </rewrite>
  </system.webServer>
</configuration>
